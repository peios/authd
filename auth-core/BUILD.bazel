load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]) + glob(
        ["tests/**/*.rs"],
        allow_empty = True,
    ),
)

rust_library(
    name = "auth-core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "auth_core",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":auth-core",
)

rust_library(
    name = "client",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["client"],
    crate_name = "auth_core",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "client-tests",
    size = "small",
    crate = ":client",
)

rust_test(
    name = "citations-test",
    size = "small",
    srcs = ["tests/no_stale_citations.rs"],
    data = ["//:rust-sources"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "./auth-core"},
)
