load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]) + glob(
        ["tests/**/*.rs"],
        allow_empty = True,
    ),
)

rust_library(
    name = "auth-policy",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:registry-seeds"],
    crate_name = "auth_policy",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = ["//auth-core"] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":auth-policy",
)

rust_library(
    name = "write",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:registry-seeds"],
    crate_features = ["write"],
    crate_name = "auth_policy",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = ["//auth-core"] + all_crate_deps(normal = True),
)

rust_test(
    name = "write-tests",
    size = "small",
    crate = ":write",
)
