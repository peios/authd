    tests: List<rust.RustTest> = rust.tests(crates(), "auth-policy", features = ["write"]),
    given: List<{at: String, place: Dir | File}> = loaded(),
) {
    = ran(tests, given)
}

def test authd(tests: List<rust.RustTest> = rust.tests(crates(), "authd"), given: List<{at: String, place: Dir | File}> = loaded()) {
