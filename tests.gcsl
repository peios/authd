# authd's tests: each member's unit and integration tests, as `cargo test
# -p` builds them, and with the features the client and the administrators
# use, which the daemons are built without.
import fs
import toolchain
import Toolchain from toolchain
import "github.com/gcslib/python"
import "github.com/gcslib/rust"

# Where the tests find the shared libraries they load.
let LIBRARIES = [{key = "LD_LIBRARY_PATH"; value = "/opt/peios/lib:/opt/auth/lib"}]

# The members of the workspace, each a directory of the same name.
let MEMBERS = [
    "auth-abi",
    "auth-core",
    "auth-policy",
    "authd",
    "libauth",
    "login",
    "lps",
    "lpsd",
    "nss",
    "peios-auth",
    "session-preferences",
    "terminal-input",
]

# What every test is given: libpeios, by its soname, which a program that
# links it loads.
def loaded() -> List<{at: String, place: Dir | File}> {
    = [{at = "/opt/peios/lib/libpeios.so.0"; place = build libpeios()}]
}

# Runs each of `tests`, given `given`.
fn ran(tests: List<rust.RustTest>, given: List<{at: String, place: Dir | File}>) -> {} {
    let each = for test in tests { = rust.run_test(test, given = given, env = LIBRARIES) }
}

def test auth_abi(tests: List<rust.RustTest> = rust.tests(crates(), "auth-abi"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

# `auth-core`'s, its citation check walking every member's sources.
def test auth_core(
    tests: List<rust.RustTest> = rust.tests(crates(), "auth-core"),
    given: List<{at: String, place: Dir | File}> = [...loaded(), ...(for each in MEMBERS { = {at = "/work/src/{each}"; place = dir(each)} })],
) {
    = ran(tests, given)
}

def test auth_core_client(
    tests: List<rust.RustTest> = rust.tests(crates(), "auth-core", features = ["client"]),
    given: List<{at: String, place: Dir | File}> = [...loaded(), ...(for each in MEMBERS { = {at = "/work/src/{each}"; place = dir(each)} })],
) {
    = ran(tests, given)
}

def test auth_policy(tests: List<rust.RustTest> = rust.tests(crates(), "auth-policy"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

