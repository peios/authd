load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]) + glob(
        ["tests/**/*.rs"],
        allow_empty = True,
    ),
)

rust_library(
    name = "terminal-input",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "terminal_input",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = ["//auth-core"] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":terminal-input",
)

# Match auth-core identity throughout the lps dependency closure.
rust_library(
    name = "client",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "terminal_input",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = ["//auth-core:client"] + all_crate_deps(normal = True),
)
