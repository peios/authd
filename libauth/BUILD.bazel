load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]) + glob(
        ["tests/**/*.rs"],
        allow_empty = True,
    ),
)

rust_library(
    name = "libauth",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "auth",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = [
        "//auth-abi",
        "//auth-core",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":libauth",
)

rust_shared_library(
    name = "shared",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "auth",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-soname,libauth.so.1"],
    version = VERSION,
    deps = [
        "//auth-abi",
        "//auth-core",
    ] + all_crate_deps(normal = True),
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"]),
)

exports_files(["exports.txt"])

# Give Bazel's runtime library graph the same filename as the embedded SONAME.
genrule(
    name = "soname",
    srcs = [":shared"],
    outs = ["libauth.so.1"],
    cmd = "cp $(execpath :shared) $@",
)

cc_import(
    name = "link",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    interface_library = ":shared",
    shared_library = select({
        "//build:native": None,
        "//conditions:default": ":soname",
    }),
    system_provided = select({
        "//build:native": True,
        "//conditions:default": False,
    }),
)
