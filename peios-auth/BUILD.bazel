load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ) + ["build.rs"],
)

rust_library(
    name = "peios-auth",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "peios_auth",
    crate_root = "src/lib.rs",
    edition = "2024",
    link_deps = ["//libauth:link"],
    version = VERSION,
    deps = ["//auth-abi"] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":peios-auth",
    data = ["//libauth:soname"],
    env = {"LD_LIBRARY_PATH": "libauth"},
)

rust_test(
    name = "client-test",
    size = "small",
    srcs = ["tests/client.rs"],
    data = ["//libauth:soname"],
    edition = "2024",
    env = {"LD_LIBRARY_PATH": "libauth"},
    deps = [
        ":peios-auth",
        "//auth-core",
    ],
)
