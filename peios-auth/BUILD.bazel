load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]) + glob(
        ["tests/**/*.rs"],
        allow_empty = True,
    ),
)

rust_library(
    name = "peios-auth",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "peios_auth",
    crate_root = "src/lib.rs",
    edition = "2024",
    link_deps = ["//libauth:link"],
    version = VERSION,
    deps = ["//auth-abi"] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":peios-auth",
)

rust_test(
    name = "client-test",
    size = "small",
    srcs = ["tests/client.rs"],
    edition = "2024",
    deps = [
        ":peios-auth",
        "//auth-core",
    ],
)
